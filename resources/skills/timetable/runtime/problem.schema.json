{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gotack timetable CP-SAT problem",
  "type": "object",
  "required": ["slots", "requirements"],
  "properties": {
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["day", "period"],
        "properties": {
          "id": {"type": "string"},
          "day": {"type": "string", "minLength": 1},
          "session": {"type": "string"},
          "period": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "class", "subject", "teacher", "periods"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "class": {"type": "string", "minLength": 1},
          "subject": {"type": "string", "minLength": 1},
          "teacher": {"type": "string", "minLength": 1},
          "periods": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "hard_constraints": {
      "type": "array",
      "items": {"$ref": "#/$defs/hardConstraint"},
      "default": []
    },
    "soft_constraints": {
      "type": "array",
      "items": {"$ref": "#/$defs/softConstraint"},
      "default": []
    },
    "template_xlsx": {"type": "string"},
    "output_xlsx": {"type": "string"}
  },
  "additionalProperties": false,
  "$defs": {
    "baseConstraint": {
      "type": "object",
      "required": ["id", "type", "description"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"type": "string"},
        "description": {"type": "string", "minLength": 1},
        "teacher": {"type": "string"},
        "class": {"type": "string"},
        "subject": {"type": "string"},
        "requirement_id": {"type": "string"},
        "days": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "day": {"type": "string"},
        "session": {"type": "string"},
        "period": {"type": "integer", "minimum": 1},
        "count": {"type": "integer", "minimum": 0}
      }
    },
    "hardConstraint": {
      "allOf": [
        {"$ref": "#/$defs/baseConstraint"},
        {
          "properties": {
            "type": {
              "enum": [
                "teacher_allowed_days",
                "teacher_forbidden_days",
                "class_allowed_days",
                "class_forbidden_days",
                "teacher_workday_count",
                "teacher_max_periods_per_day",
                "fixed_slot",
                "forbidden_slot"
              ]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "softConstraint": {
      "allOf": [
        {"$ref": "#/$defs/baseConstraint"},
        {
          "required": ["weight"],
          "properties": {
            "type": {
              "enum": [
                "teacher_preferred_days",
                "teacher_avoid_days",
                "class_preferred_days",
                "class_avoid_days",
                "preferred_slot",
                "avoid_slot",
                "teacher_workday_count",
                "teacher_max_periods_per_day"
              ]
            },
            "weight": {"type": "integer", "minimum": 1}
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
