+type modelCallTransportObserver struct {
+	trace       *RunTrace
+	modelCallID int
+	purpose     string
+	httpAttempt int
+}
+
+func (t *RunTrace) modelCallContext(ctx context.Context, purpose string) context.Context {
+	if t == nil {
+		return ctx
+	}
+	t.mu.Lock()
+	t.modelCallSeq++
+	id := t.modelCallSeq
+	t.mu.Unlock()
+	return fantasy.WithTransportObserver(ctx, &modelCallTransportObserver{trace: t, modelCallID: id, purpose: purpose})
+}
+
+func (o *modelCallTransportObserver) ObserveTransportEvent(event fantasy.TransportEvent) {
+	if o == nil || o.trace == nil {
+		return
+	}
+	o.trace.mu.Lock()
+	defer o.trace.mu.Unlock()
+	if event.Kind == fantasy.TransportEventRequestEncoded {
+		o.httpAttempt++
+		purpose := o.purpose
+		if o.httpAttempt > 1 {
+			purpose = "retry"
+		}
+		o.trace.providerAttempts = append(o.trace.providerAttempts, notify.ProviderAttemptTelemetry{
+			ModelCallID: o.modelCallID,
+			HTTPAttempt: o.httpAttempt,
+			Purpose:     purpose,
+		})
+	}
+	if o.httpAttempt == 0 || len(o.trace.providerAttempts) == 0 {
+		return
+	}
+	var attempt *notify.ProviderAttemptTelemetry
+	for i := len(o.trace.providerAttempts) - 1; i >= 0; i-- {
+		candidate := &o.trace.providerAttempts[i]
+		if candidate.ModelCallID == o.modelCallID && candidate.HTTPAttempt == o.httpAttempt {
+			attempt = candidate
+			break
+		}
+	}
+	if attempt == nil {
+		return
+	}
+	now := time.Since(o.trace.anchor).Microseconds()
+	if now < 0 {
+		now = 0
+	}
+	setOnce := func(dst **int64) {
+		if *dst == nil {
+			value := now
+			*dst = &value
+		}
+	}
+	switch event.Kind {
+	case fantasy.TransportEventRequestEncoded:
+		setOnce(&attempt.RequestEncodedMicros)
+	case fantasy.TransportEventRequestWritten:
+		setOnce(&attempt.RequestWrittenMicros)
+	case fantasy.TransportEventFirstResponseByte:
+		setOnce(&attempt.FirstResponseByteMicros)
+	case fantasy.TransportEventResponseHeaders:
+		setOnce(&attempt.ResponseHeadersMicros)
+	case fantasy.TransportEventFirstSSEFrame:
+		setOnce(&attempt.FirstSSEFrameMicros)
+		if attempt.FirstResponseByteMicros != nil && attempt.FirstByteToFirstSSEMicros == nil {
+			delta := now - *attempt.FirstResponseByteMicros
+			if delta < 0 {
+				delta = 0
+			}
+			attempt.FirstByteToFirstSSEMicros = &delta
+		}
+	}
+}
