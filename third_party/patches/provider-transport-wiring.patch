+package agent
+
+import (
+	"context"
+	"testing"
+
+	"charm.land/fantasy"
+	"github.com/stretchr/testify/require"
+)
+
+func TestRunTraceProviderTransportAttemptIdentity(t *testing.T) {
+	trace := newRunTrace("run-provider")
+	ctx := trace.modelCallContext(context.Background(), "tool_loop")
+	for _, kind := range []fantasy.TransportEventKind{
+		fantasy.TransportEventRequestEncoded,
+		fantasy.TransportEventRequestWritten,
+		fantasy.TransportEventFirstResponseByte,
+		fantasy.TransportEventResponseHeaders,
+		fantasy.TransportEventFirstSSEFrame,
+	} {
+		fantasy.ReportTransportEvent(ctx, fantasy.TransportEvent{Kind: kind})
+	}
+	snap := trace.Snapshot()
+	require.Len(t, snap.ProviderAttempts, 1)
+	attempt := snap.ProviderAttempts[0]
+	require.Equal(t, 1, attempt.ModelCallID)
+	require.Equal(t, 1, attempt.HTTPAttempt)
+	require.Equal(t, "tool_loop", attempt.Purpose)
+	require.NotNil(t, attempt.RequestEncodedMicros)
+	require.NotNil(t, attempt.RequestWrittenMicros)
+	require.NotNil(t, attempt.FirstResponseByteMicros)
+	require.NotNil(t, attempt.ResponseHeadersMicros)
+	require.NotNil(t, attempt.FirstSSEFrameMicros)
+	require.NotNil(t, attempt.FirstByteToFirstSSEMicros)
+	require.GreaterOrEqual(t, *attempt.FirstByteToFirstSSEMicros, int64(0))
+}
+
+func TestRunTraceProviderTransportRetryGetsOwnAttemptIdentity(t *testing.T) {
+	trace := newRunTrace("run-provider")
+	first := trace.modelCallContext(context.Background(), "tool_loop")
+	second := trace.modelCallContext(context.Background(), "tool_loop")
+
+	fantasy.ReportTransportEvent(first, fantasy.TransportEvent{Kind: fantasy.TransportEventRequestEncoded})
+	fantasy.ReportTransportEvent(second, fantasy.TransportEvent{Kind: fantasy.TransportEventRequestEncoded})
+	fantasy.ReportTransportEvent(first, fantasy.TransportEvent{Kind: fantasy.TransportEventFirstResponseByte})
+	fantasy.ReportTransportEvent(second, fantasy.TransportEvent{Kind: fantasy.TransportEventFirstResponseByte})
+	fantasy.ReportTransportEvent(first, fantasy.TransportEvent{Kind: fantasy.TransportEventFirstSSEFrame})
+	fantasy.ReportTransportEvent(second, fantasy.TransportEvent{Kind: fantasy.TransportEventFirstSSEFrame})
+	// A retry inside the first provider call stays on model-call 1 but
+	// receives its own HTTP-attempt identity and retry purpose.
+	fantasy.ReportTransportEvent(first, fantasy.TransportEvent{Kind: fantasy.TransportEventRequestEncoded})
+	fantasy.ReportTransportEvent(first, fantasy.TransportEvent{Kind: fantasy.TransportEventFirstResponseByte})
+	fantasy.ReportTransportEvent(first, fantasy.TransportEvent{Kind: fantasy.TransportEventFirstSSEFrame})
+
+	snap := trace.Snapshot()
+	require.Len(t, snap.ProviderAttempts, 3)
+	require.Equal(t, 1, snap.ProviderAttempts[0].ModelCallID)
+	require.Equal(t, 1, snap.ProviderAttempts[0].HTTPAttempt)
+	require.Equal(t, "tool_loop", snap.ProviderAttempts[0].Purpose)
+	require.Equal(t, 2, snap.ProviderAttempts[1].ModelCallID)
+	require.Equal(t, 1, snap.ProviderAttempts[1].HTTPAttempt)
+	require.Equal(t, "tool_loop", snap.ProviderAttempts[1].Purpose)
+	require.Equal(t, 1, snap.ProviderAttempts[2].ModelCallID)
+	require.Equal(t, 2, snap.ProviderAttempts[2].HTTPAttempt)
+	require.Equal(t, "retry", snap.ProviderAttempts[2].Purpose)
+	for _, attempt := range snap.ProviderAttempts {
+		require.NotNil(t, attempt.FirstResponseByteMicros)
+		require.NotNil(t, attempt.FirstSSEFrameMicros)
+		require.NotNil(t, attempt.FirstByteToFirstSSEMicros)
+	}
+}
