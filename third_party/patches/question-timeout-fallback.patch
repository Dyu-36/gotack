+const questionFallbackInstruction = "Interactive question timed out or is disabled for this session. Do not call the question tool again. Ask the user for the missing information directly in your assistant response, end the turn, and wait for their next message."
+
+var errQuestionFallback = errors.New("question requires plain-text fallback")
 
 //go:embed question.md
 var questionDescription string
 
+type questionAsker interface {
+	Ask(context.Context, question.Request) ([]question.Answer, error)
+}
+
+type questionFallbackState struct {
+	timeout  time.Duration
+	disabled sync.Map
+}
+
+func (s *questionFallbackState) ask(ctx context.Context, sessionID string, svc questionAsker, req question.Request) ([]question.Answer, error) {
+	if sessionID != "" {
+		if _, disabled := s.disabled.Load(sessionID); disabled {
+			return nil, errQuestionFallback
+		}
+	}
+
+	askCtx, cancel := context.WithTimeout(ctx, s.timeout)
+	defer cancel()
+	answers, err := svc.Ask(askCtx, req)
+	if errors.Is(err, context.DeadlineExceeded) && ctx.Err() == nil {
+		if sessionID != "" {
+			s.disabled.Store(sessionID, struct{}{})
+		}
+		return nil, errQuestionFallback
+	}
+	return answers, err
+}
