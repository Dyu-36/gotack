@@ -0,0 +1,38 @@
+package question
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestAskPublishesNotificationWhenContextExpires(t *testing.T) {
+	svc := NewService()
+	subCtx, stop := context.WithCancel(context.Background())
+	defer stop()
+	notifications := svc.SubscribeNotifications(subCtx)
+
+	askCtx, cancel := context.WithTimeout(context.Background(), 10*time.Millisecond)
+	defer cancel()
+	done := make(chan error, 1)
+	go func() {
+		_, err := svc.Ask(askCtx, Request{
+			ID: "batch-timeout",
+			Questions: []Question{{
+				Type: TypeFreeText, Text: "Missing data?", Description: "Provide the missing data.",
+			}},
+		})
+		done <- err
+	}()
+
+	select {
+	case notification := <-notifications:
+		require.Equal(t, "batch-timeout", notification.Payload.BatchID)
+	case <-time.After(time.Second):
+		t.Fatal("timed out waiting for question notification")
+	}
+
+	require.ErrorIs(t, <-done, context.DeadlineExceeded)
+}
