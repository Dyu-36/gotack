+type blockingQuestionAsker struct {
+	calls int
+}
+
+func (s *blockingQuestionAsker) Ask(ctx context.Context, _ question.Request) ([]question.Answer, error) {
+	s.calls++
+	<-ctx.Done()
+	return nil, ctx.Err()
+}
+
+func TestQuestionFallbackTimesOutAndDisablesSession(t *testing.T) {
+	require.Equal(t, 60*time.Second, questionAnswerTimeout)
+	state := &questionFallbackState{timeout: 10 * time.Millisecond}
+	svc := &blockingQuestionAsker{}
+
+	_, err := state.ask(context.Background(), "session-1", svc, question.Request{})
+	require.ErrorIs(t, err, errQuestionFallback)
+	require.Equal(t, 1, svc.calls)
+
+	_, err = state.ask(context.Background(), "session-1", svc, question.Request{})
+	require.ErrorIs(t, err, errQuestionFallback)
+	require.Equal(t, 1, svc.calls, "disabled sessions must not wait a second time")
+}
