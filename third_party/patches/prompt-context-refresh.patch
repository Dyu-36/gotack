+// RefreshPrompt rebuilds the current coder prompt from the live workspace
+// configuration without replacing the coordinator or its session state.
+func (c *coordinator) RefreshPrompt(ctx context.Context) error {
+	if err := c.readyWg.Wait(); err != nil {
+		return err
+	}
+
+	c.skillsRefreshMu.Lock()
+	defer c.skillsRefreshMu.Unlock()
+
+	model := c.currentAgent.Model()
+	p, err := coderPrompt(prompt.WithWorkingDir(c.cfg.WorkingDir()))
+	if err != nil {
+		return err
+	}
+	systemPrompt, err := p.Build(context.WithoutCancel(ctx), model.Model.Provider(), model.Model.Model(), c.cfg)
+	if err != nil {
+		return err
+	}
+	c.currentAgent.SetSystemPrompt(systemPrompt)
+	return nil
+}
