+func TestRegisterRecencyIsMonotonic(t *testing.T) {
+	tmpDir := t.TempDir()
+	t.Setenv("XDG_DATA_HOME", tmpDir)
+	t.Setenv("CRUSH_GLOBAL_DATA", filepath.Join(tmpDir, "crush"))
+
+	// Seed a timestamp ahead of the wall clock. Register must still make the
+	// newly accessed project strictly newer instead of trusting time.Now alone.
+	future := time.Now().UTC().Add(time.Hour)
+	err := Save(&ProjectList{Projects: []Project{{
+		Path:         "/home/user/project1",
+		DataDir:      "/home/user/project1/.crush",
+		LastAccessed: future,
+	}}})
+	if err != nil {
+		t.Fatalf("Save failed: %v", err)
+	}
+
+	err = Register("/home/user/project2", "/home/user/project2/.crush")
+	if err != nil {
+		t.Fatalf("Register failed: %v", err)
+	}
+
+	projects, err := List()
+	if err != nil {
+		t.Fatalf("List failed: %v", err)
+	}
+	if len(projects) != 2 {
+		t.Fatalf("Expected 2 projects, got %d", len(projects))
+	}
+	if projects[0].Path != "/home/user/project2" {
+		t.Fatalf("Expected newly registered project first, got %s", projects[0].Path)
+	}
+	if !projects[0].LastAccessed.After(future) {
+		t.Fatalf("Expected monotonic LastAccessed after %s, got %s", future, projects[0].LastAccessed)
+	}
+}
