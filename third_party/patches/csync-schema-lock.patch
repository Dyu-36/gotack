--- /dev/null
+++ b/internal/csync/maps_schema_test.go
@@ -0,0 +1,31 @@
+package csync
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/invopop/jsonschema"
+)
+
+func TestMapSchemaAliasPreservesValueAndPointerSchema(t *testing.T) {
+	for _, input := range []any{Map[string, int]{}, NewMap[string, int]()} {
+		r := jsonschema.Reflector{DoNotReference: true}
+		schema := r.Reflect(input)
+		if schema.Type != "object" || schema.AdditionalProperties == nil || schema.AdditionalProperties.Type != "integer" {
+			t.Fatalf("map schema lost its value type: %#v", schema)
+		}
+	}
+	m := NewMap[string, int]()
+	m.Set("answer", 42)
+	// The promoted schema method does not access the map or acquire its lock.
+	m.mu.Lock()
+	alias := m.JSONSchemaAlias()
+	m.mu.Unlock()
+	if _, ok := alias.(map[string]int); !ok {
+		t.Fatal("wrong schema alias type")
+	}
+	data, err := json.Marshal(m)
+	if err != nil || string(data) != `{"answer":42}` {
+		t.Fatalf("map JSON changed: %s, %v", data, err)
+	}
+}
