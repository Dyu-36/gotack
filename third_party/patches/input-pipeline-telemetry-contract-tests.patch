diff --git a/internal/agent/runtrace_test.go b/internal/agent/runtrace_test.go
new file mode 100644
index 0000000..f94e865
--- /dev/null
+++ b/internal/agent/runtrace_test.go
@@ -0,0 +1,116 @@
+package agent
+
+import (
+	"bytes"
+	"context"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestRunTraceResponsesTelemetry(t *testing.T) {
+	keyPath := filepath.Join(t.TempDir(), "run-metrics.key")
+	if err := os.WriteFile(keyPath, bytes.Repeat([]byte{0x2a}, 32), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv(runMetricsKeyFileEnv, keyPath)
+
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		w.Header().Set("Content-Type", "text/event-stream")
+		w.Header().Set("X-Request-ID", "req_fixture")
+		flusher, ok := w.(http.Flusher)
+		if !ok {
+			t.Fatal("response writer is not a flusher")
+		}
+		_, _ = io.WriteString(w, "event: response.created\ndata: {\"type\":\"response.created\"}\n\n")
+		flusher.Flush()
+		_, _ = io.WriteString(w, "event: response.completed\ndata: {\"type\":\"response.completed\",\"response\":{\"service_tier\":\"standard\",\"usage\":{\"input_tokens\":42,\"input_tokens_details\":{\"cached_tokens\":0}}}}\n\n")
+		flusher.Flush()
+	}))
+	defer server.Close()
+
+	trace := newRunTrace("run_fixture")
+	trace.setIdentity("fixture", "gpt-5-fixture", "medium")
+	maxOutput := int64(2048)
+	trace.setRequestShape(3, 1, 2, &maxOutput, nil, nil, nil, nil, nil)
+
+	req, err := http.NewRequestWithContext(withRunTrace(context.Background(), trace), http.MethodPost, server.URL, http.NoBody)
+	if err != nil {
+		t.Fatal(err)
+	}
+	client := wrapRunTraceHTTPClient(server.Client())
+	resp, err := client.Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, readErr := io.Copy(io.Discard, resp.Body)
+	closeErr := resp.Body.Close()
+	if readErr != nil || closeErr != nil {
+		t.Fatal("failed to consume response")
+	}
+	trace.markSemantic("text", time.Now())
+	trace.markStepFinish(time.Now())
+
+	telemetry := trace.telemetry()
+	if telemetry == nil {
+		t.Fatal("telemetry missing")
+	}
+	if telemetry.RunID != "run_fixture" || telemetry.Provider != "fixture" || telemetry.Model != "gpt-5-fixture" {
+		t.Fatalf("identity mismatch: %#v", telemetry)
+	}
+	if telemetry.Attempt != 1 || telemetry.RetryCount != 0 {
+		t.Fatalf("attempt mismatch: %#v", telemetry)
+	}
+	if telemetry.CacheStatus != "miss" || telemetry.CachedInputTokens == nil || *telemetry.CachedInputTokens != 0 {
+		t.Fatalf("cache miss was not preserved: %#v", telemetry)
+	}
+	if telemetry.UncachedInputTokens == nil || *telemetry.UncachedInputTokens != 42 {
+		t.Fatalf("uncached tokens mismatch: %#v", telemetry)
+	}
+	if telemetry.ProviderRequestID != "req_fixture" || telemetry.ServiceTier != "standard" {
+		t.Fatalf("provider metadata mismatch: %#v", telemetry)
+	}
+	if telemetry.RequestShapeHMAC == "" || telemetry.RequestShapeBytes == 0 {
+		t.Fatalf("request shape fingerprint missing: %#v", telemetry)
+	}
+	if telemetry.FirstSemantic != "text" || telemetry.TotalMicros < 0 {
+		t.Fatalf("semantic timing mismatch: %#v", telemetry)
+	}
+	for name, duration := range telemetry.SpansMicros {
+		if duration < 0 {
+			t.Fatalf("negative span %s=%d", name, duration)
+		}
+	}
+	if _, ok := telemetry.SpansMicros["request_write_to_first_byte"]; !ok {
+		t.Fatalf("write-to-first-byte span missing: %#v", telemetry.SpansMicros)
+	}
+	if _, ok := telemetry.SpansMicros["first_byte_to_first_sse"]; !ok {
+		t.Fatalf("first-byte-to-SSE span missing: %#v", telemetry.SpansMicros)
+	}
+}
+
+func TestRunTraceCacheTriStateAndMasking(t *testing.T) {
+	trace := newRunTrace("run_fixture")
+	trace.captureCompletedFrame([]byte(`{"type":"response.completed","response":{"usage":{"input_tokens":9,"input_tokens_details":{}}}}`))
+	if got := trace.telemetry().CacheStatus; got != "unreported" {
+		t.Fatalf("omitted cached_tokens must stay unreported, got %q", got)
+	}
+
+	ctx := withRunTrace(context.Background(), trace)
+	if runTraceFromContext(ctx) != trace {
+		t.Fatal("trace context missing")
+	}
+	if runTraceFromContext(withoutRunTrace(ctx)) != nil {
+		t.Fatal("auxiliary context did not mask trace")
+	}
+
+	trace.recordRetry(25 * time.Millisecond)
+	telemetry := trace.telemetry()
+	if telemetry.RetryCount != 1 || telemetry.RetryDelayMicros != 25_000 {
+		t.Fatalf("retry telemetry mismatch: %#v", telemetry)
+	}
+}
