+func runTelemetryToProto(in *notify.RunTelemetry) *proto.RunTelemetry {
+	if in == nil {
+		return nil
+	}
+	spans := make(map[string]int64, len(in.SpansMicros))
+	for name, duration := range in.SpansMicros {
+		spans[name] = duration
+	}
+	return &proto.RunTelemetry{
+		RunID: in.RunID, Provider: in.Provider, Model: in.Model, ReasoningEffort: in.ReasoningEffort,
+		Attempt: in.Attempt, RetryCount: in.RetryCount, RetryDelayMicros: in.RetryDelayMicros,
+		SpansMicros: spans, TotalMicros: in.TotalMicros, FirstSemantic: in.FirstSemantic,
+		CacheStatus: in.CacheStatus, CachedInputTokens: in.CachedInputTokens, UncachedInputTokens: in.UncachedInputTokens,
+		ServiceTier: in.ServiceTier, ProviderRequestID: in.ProviderRequestID, EstimatedUsage: in.EstimatedUsage,
+		Compacted: in.Compacted, PrefixChangedReason: in.PrefixChangedReason,
+		StablePrefixHMAC: in.StablePrefixHMAC, StablePrefixBytes: in.StablePrefixBytes,
+		DynamicSuffixHMAC: in.DynamicSuffixHMAC, DynamicSuffixBytes: in.DynamicSuffixBytes,
+		RequestShapeHMAC: in.RequestShapeHMAC, RequestShapeBytes: in.RequestShapeBytes,
