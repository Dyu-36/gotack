+func TestResponsesPromptKeepsEncryptedOnlyAssistantMessage(t *testing.T) {
+	t.Parallel()
+
+	encryptedContent := "gAAAAABthree-synthetic-encrypted-payload"
+
+	prompt := fantasy.Prompt{
+		{
+			Role: fantasy.MessageRoleUser,
+			Content: []fantasy.MessagePart{
+				fantasy.TextPart{Text: "What is 2+2?"},
+			},
+		},
+		{
+			// Encrypted-only assistant turn: no thinking text, no
+			// tool calls. The encrypted reasoning item is the only
+			// content.
+			Role: fantasy.MessageRoleAssistant,
+			Content: []fantasy.MessagePart{
+				fantasy.ReasoningPart{
+					ProviderOptions: fantasy.ProviderOptions{
+						Name: &ResponsesReasoningMetadata{
+							ItemID:           "rs_encrypted_only",
+							EncryptedContent: &encryptedContent,
+						},
+					},
+				},
+			},
+		},
+		{
+			Role: fantasy.MessageRoleUser,
+			Content: []fantasy.MessagePart{
+				fantasy.TextPart{Text: "And 3+3?"},
+			},
+		},
+	}
+
+	input, warnings := toResponsesPrompt(prompt, "system", false)
+	require.Empty(t, warnings)
+
+	// The assistant message must not be dropped as empty: its
+	// encrypted reasoning item counts as visible assistant content.
+	require.Len(t, input, 3)
+	require.NotNil(t, input[0].OfMessage)
+	require.NotNil(t, input[1].OfReasoning)
+	require.Equal(t, "rs_encrypted_only", input[1].OfReasoning.ID)
+	require.True(t, input[1].OfReasoning.EncryptedContent.Valid())
+	require.Equal(t, encryptedContent, input[1].OfReasoning.EncryptedContent.Value)
+	require.Empty(t, input[1].OfReasoning.Summary)
+	require.NotNil(t, input[2].OfMessage)
+}
