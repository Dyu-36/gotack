+func TestResponsesPromptReplaysEncryptedReasoning(t *testing.T) {
+	t.Parallel()
+
+	encryptedOne := "gAAAAABone-synthetic-encrypted-payload"
+	encryptedTwo := "gAAAAABtwo-synthetic-encrypted-payload"
+
+	prompt := fantasy.Prompt{
+		{
+			Role: fantasy.MessageRoleUser,
+			Content: []fantasy.MessagePart{
+				fantasy.TextPart{Text: "Run the plan"},
+			},
+		},
+		{
+			Role: fantasy.MessageRoleAssistant,
+			Content: []fantasy.MessagePart{
+				fantasy.ReasoningPart{
+					Text: "reasoning display text",
+					ProviderOptions: fantasy.ProviderOptions{
+						Name: &ResponsesReasoningMetadata{
+							ItemID:           "rs_step_one",
+							EncryptedContent: &encryptedOne,
+							Summary:          []string{"summary must not be replayed"},
+						},
+					},
+				},
+				fantasy.ToolCallPart{ToolCallID: "call_1", ToolName: "step_one", Input: `{}`},
+				fantasy.ReasoningPart{
+					ProviderOptions: fantasy.ProviderOptions{
+						Name: &ResponsesReasoningMetadata{
+							ItemID:           "rs_step_two",
+							EncryptedContent: &encryptedTwo,
+						},
+					},
+				},
+				fantasy.ToolCallPart{ToolCallID: "call_2", ToolName: "step_two", Input: `{}`},
+			},
+		},
+	}
+
+	input, warnings := toResponsesPrompt(prompt, "developer", false)
+	require.Empty(t, warnings)
+	require.Len(t, input, 5)
+
+	// Both encrypted reasoning items are replayed in relative order,
+	// each immediately before the function call that depended on it.
+	require.NotNil(t, input[0].OfMessage)
+	require.NotNil(t, input[1].OfReasoning)
+	require.Equal(t, "rs_step_one", input[1].OfReasoning.ID)
+	require.True(t, input[1].OfReasoning.EncryptedContent.Valid())
+	require.Equal(t, encryptedOne, input[1].OfReasoning.EncryptedContent.Value)
+	require.Empty(t, input[1].OfReasoning.Summary)
+
+	require.NotNil(t, input[2].OfFunctionCall)
+	require.Equal(t, "call_1", input[2].OfFunctionCall.CallID)
+
+	require.NotNil(t, input[3].OfReasoning)
+	require.Equal(t, "rs_step_two", input[3].OfReasoning.ID)
+	require.True(t, input[3].OfReasoning.EncryptedContent.Valid())
+	require.Equal(t, encryptedTwo, input[3].OfReasoning.EncryptedContent.Value)
+	require.Empty(t, input[3].OfReasoning.Summary)
+
+	require.NotNil(t, input[4].OfFunctionCall)
+	require.Equal(t, "call_2", input[4].OfFunctionCall.CallID)
+
+	// Reasoning display text and summaries must never be replayed as
+	// assistant message text.
+	for _, item := range input[1:] {
+		require.Nil(t, item.OfMessage,
+			"replayed reasoning turns must not produce assistant text items")
+	}
+	encoded, err := json.Marshal(input)
+	require.NoError(t, err)
+	require.NotContains(t, string(encoded), "reasoning display text")
+	require.NotContains(t, string(encoded), "summary must not be replayed")
+}
