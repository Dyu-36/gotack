+// validateReasoningReplayPrompt rejects unsafe or ambiguous replay before an
+// HTTP request can be constructed. Item IDs are provider identities, so
+// silently deduplicating them could attach an encrypted item to the wrong
+// assistant/tool segment.
+func validateReasoningReplayPrompt(prompt fantasy.Prompt, store bool) error {
+	seen := make(map[string]struct{})
+	for _, msg := range prompt {
+		if msg.Role != fantasy.MessageRoleAssistant {
+			continue
+		}
+		for _, content := range msg.Content {
+			reasoning, ok := fantasy.AsContentType[fantasy.ReasoningPart](content)
+			if !ok {
+				continue
+			}
+			metadata := GetReasoningMetadata(reasoning.ProviderOptions)
+			if metadata == nil || metadata.ItemID == "" || metadata.EncryptedContent == nil || *metadata.EncryptedContent == "" {
+				continue
+			}
+			if store {
+				return errors.New(reasoningReplayStoreError)
+			}
+			if _, exists := seen[metadata.ItemID]; exists {
+				return errors.New(duplicateReasoningItemIDError)
+			}
+			seen[metadata.ItemID] = struct{}{}
+		}
+	}
+	return nil
+}
