# ==========================================
# Go / Wails Build Artifacts
# ==========================================
build/bin/
*.exe
*.exe~
*.app
*.deb
*.rpm
*.dll
*.so
*.dylib

# Go Test & Debug
*.test
*.out
*.prof
__debug_bin*

# Wails generated bindings (rebuilt by wails dev/build)
frontend/wailsjs/

# ==========================================
# Frontend (Svelte / Vite / Node)
# ==========================================
node_modules/
.pnpm-store/
frontend/dist/*
!frontend/dist/.gitkeep
frontend/.vite/
*.tsbuildinfo
*.md5
frontend/package.json.md5
.eslintcache

# ==========================================
# Environment & Secrets
# ==========================================
.env
.env.*
!.env.example
!.env.template

# ==========================================
# IDEs / Editors / Agent Configs
# ==========================================
/AGENTS.md
.codex/
.vscode/
.idea/
.vs/
.fleet/
*.swp
*.swo
.omp/
.qoder/
.agents/
.claude/
skills-lock.json
agent/

# ==========================================
# Logs & Temp
# ==========================================
*.log
tmp/
*.tmp
coverage/

# ==========================================
# OS Generated Files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ==========================================
# Project Specific
# ==========================================
# Workspace runtime data directories
/.tack/

# Local history archives
/.history-backup/

# Separately versioned engine source checkout
/tack-engine-source/
/.engine-source/
/product-sources/
/package-inspection/

# Reproducible downloaded runtime payloads; build/release tooling recreates these as needed.
/resources/bin/*
!/resources/bin/.gitkeep

# Harness core maintenance binary
scripts/bin/

# Repomix output
repomix*

# Artifacts & Local test screenshots
/artifacts/
/*.png
